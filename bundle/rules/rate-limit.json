      "list": "html@js:var pre=0,post=0,m;var rp=/li:nth-child\\((\\d+)\\)\\s*\\{\\s*display\\s*:\\s*none/g;while((m=rp.exec(r))){pre=Math.max(pre,+m[1]);}var rq=/li:nth-last-child\\((\\d+)\\)\\s*\\{\\s*display\\s*:\\s*none/g;while((m=rq.exec(r))){post=Math.max(post,+m[1]);}var cnt={},rb=/\\/book\\/(\\d+)\\//g;while((m=rb.exec(r))){cnt[m[1]]=(cnt[m[1]]||0)+1;}var bid='',bn=0;for(var k in cnt){if(cnt[k]>bn){bn=cnt[k];bid=k;}}var best=[],bestN=-1,ru=/<ul[^>]*class=\"[^\"]*yanqing_list[^\"]*\"[^>]*>([\\s\\S]*?)<\\/ul>/g;while((m=ru.exec(r))){var lis=m[1].match(/<li[\\s\\S]*?<\\/li>/g)||[];if(lis.length>bestN){bestN=lis.length;best=lis;}}if(bestN>0){best=best.slice(pre,bestN-post);}r='<ul class=\"yanqing_list\">'+best.join('').replace(/<a\\s+onclick=\"read_tz\\((\\d+)\\);?\">/g,'<a href=\"https://www.xbiquge.cc/book/'+bid+'/$1.html\">').replace(/href=\"\\//g,'href=\"https://www.xbiquge.cc/')+'</ul>';",
